#import "skin://theme.view"

widget(container_y, {

  widget(container_x, {
    height: 3em;
    BackButton();
  });


  widget(container_x, {
    align: center;
    spacing: 1em;

    widget(icon, {
      size: 3em;
      source: "skin://icons/movian.svg";
    });
    widget(label, {
      caption: $core.app.nameM;
      size: 3em;
    });
  });

  widget(label, {
    caption: $core.app.versionDisplay;
    alpha: 0.5;
    align: center;
  });

  widget(label, {
    hidden: isVoid($core.app.installationType);
    caption: $core.app.installationType;
    alpha: 0.5;
    align: center;
  });

  widget(dummy, {
    height: 2em;
  });

  widget(label, {
    caption: $core.app.copyright;
    alpha: 0.5;
    align: center;
  });

  widget(dummy, {
    height: 0.5em;
  });

  widget(label, {
    caption: $core.app.copyright2;
    alpha: 0.6;
    align: center;
  });

  widget(dummy, {
    height: 0.5em;
  });

  widget(container_x, {
    align: center;
    clickable: true;
    focusable: true;
    onEvent(activate, navOpen("showtime:about-movian"));
    widget(label, {
      caption: "https://movian.eu";
      color: [0.35, 0.65, 1];
      alpha: 0.7 + 0.3 * isHovered();
      align: center;
    });
  });

  widget(dummy, {
    height: 0.5em;
  });

  widget(container_x, {
    align: center;
    clickable: true;
    focusable: true;
    onEvent(activate, navOpen("showtime:about-donate"));
    widget(label, {
      caption: "https://paypal.me/webpluginsBG";
      color: [0.35, 0.65, 1];
      alpha: 0.6 + 0.4 * isHovered();
      align: center;
    });
  });
});
