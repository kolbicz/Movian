


#define InfoLabel() {
  shadow: true;
  outline: true;
  color: 0.6;
  size: 0.8em;
}


#define InfoLine(TITLE, VAL, HIDDEN=false) {
  widget(container_x, {
    tableMode: true;
    hidden: HIDDEN;
    spacing: 0.8em;
    widget(label, {
      InfoLabel();
      align: right;
      caption: TITLE + ":";
    });
    widget(label, {
      caption: VAL;
	  size: 0.8em;
    });
  });
}

#define InfoBar(TITLE, VAL) {
  widget(container_x, {
    spacing: 0.8em;
    tableMode: true;
    widget(label, {
      InfoLabel();
      align: right;
      caption: TITLE + ":";
	  size: 0.8em;
    });

    widget(container_z, {
      width: 6em;
      widget(quad, {
        color: 0.4;
      });
      widget(bar, {
        color1: 1;
        color2: 1;
	fill: VAL;
      });
    });
  });
}

