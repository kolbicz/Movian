#import "info_include.view"

// Newer iOS GLW runtimes do not reliably render the deeply nested conditional
// table used by the M7 desktop view. Keep the proven flat table structure while
// exposing the additional M7 media and network information when available.
widget(container_x, {
  widget(container_z, {
    widget(quad, {
      alpha: 0.75;
      color: 0;
    });

    widget(container_y, {
      padding: 1em;

      widget(label, {
        hidden: !isVoid($core.media.current.url);
        caption: _("No media loaded");
      });

      widget(table, {
        hidden: isVoid($core.media.current.url);

        widget(container_y, {
          InfoLine(_("Source"),
                   $core.media.current.metadata.format ??
                   $core.media.current.format);

          InfoLine(_("Video codec"),
                   $core.media.current.video.codec,
                   isVoid($core.media.current.video.codec));

          InfoLine(_("Video info"),
                   select($core.media.current.video.bitrate > 4499,
                          fmt("%2d fps • %d Mb/s",
                              $core.media.current.fps,
                              ($core.media.current.video.bitrate + 500) / 1000),
                          fmt("%2d fps • %d kb/s",
                              $core.media.current.fps,
                              $core.media.current.video.bitrate)),
                   isVoid($core.media.current.fps));

          InfoLine(_("Audio codec"),
                   fmt("%s • %d kb/s",
                       $core.media.current.audio.codec,
                       $core.media.current.audio.bitrate),
                   isVoid($core.media.current.audio.codec));

          InfoLine(_("Audio output"),
                   $core.media.current.audio.audio_codec_out,
                   isVoid($core.media.current.audio.audio_codec_out));

          InfoLine(_("Transfer speed"),
                   fmt("%i Mb/s", $core.media.current.video.bandwidth),
                   isVoid($core.media.current.video.bandwidth));

          InfoLine(_("Connected to"),
                   fmt("%d %s • %s %d • %s %d",
                       $core.media.current.io.infoNodes1.conn,
                       _("Peers"),
                       _("Seeders"),
                       $core.media.current.io.infoNodes1.seed,
                       _("Peers"),
                       $core.media.current.io.infoNodes1.peer),
                   isVoid($core.media.current.io.infoNodes1.conn));

          InfoLine(_("Active"),
                   fmt("%d pcs • %s %d MB • %s %d %sb/s",
                       $core.media.current.io.infoNodes2.pcs,
                       _("Cache"),
                       $core.media.current.io.infoNodes2.cch,
                       _("Speed"),
                       select($core.media.current.io.infoNodes2.spd > 4500,
                              $core.media.current.io.infoNodes2.spd / 1000,
                              $core.media.current.io.infoNodes2.spd),
                       select($core.media.current.io.infoNodes2.spd > 4500,
                              "M", "k")),
                   isVoid($core.media.current.io.infoNodes2.pcs));

          InfoBar(_("Buffer usage"),
                  $core.media.current.buffer.current /
                  $core.media.current.buffer.limit);

          InfoLine(_("Buffer"),
                   select($core.media.current.buffer.delay > 0 &&
                          ($core.media.current.buffer.current * 8 /
                           $core.media.current.buffer.delay) / 1000 > 4499,
                          fmt("%d sec • %d MB • %.0f Mb/s",
                              $core.media.current.buffer.delay,
                              $core.media.current.buffer.current / 1048576,
                              (($core.media.current.buffer.current * 8 /
                                $core.media.current.buffer.delay) / 1000000) +
                              0.5f),
                          fmt("%d sec • %d MB • %.0f kb/s",
                              $core.media.current.buffer.delay,
                              $core.media.current.buffer.current / 1048576,
                              select($core.media.current.buffer.delay > 0,
                                     ($core.media.current.buffer.current * 8 /
                                      $core.media.current.buffer.delay) / 1000,
                                     0))));
        });
      });
    });
  });
});
