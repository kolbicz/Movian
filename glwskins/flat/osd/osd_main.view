#import "skin://theme.view"
#import "skin://menu/sidebar_include.view"


widget(container_y, {
	width: 22em;
	id: "osd_main";

	widget(container_z, {
		height: 3em;
		clickable: true;
		onEvent(activate, {
			$clone.osdpage = 0;
			$clone.showPlaydeck = 0;
		}, true, true, true);
		widget(container_x, {
		widget(container_y, {
			align: center;
			width: 4em;
			clickable: true;
			onEvent(activate, {
				$clone.osdpage = 0;
				$clone.showPlaydeck = 0;
			}, true, true, true);
			navFocusable: false;
			widget(icon, {
				color: 1;
				size: 2em;
				source: "skin://icons/ic_chevron_left_48px.svg";
			});
		});
		space(1);
		});
	});

	widget(list_y, {

	id: "sidebar";
	navWrap: true;

	SIDEBAR_ACTION(_("Video settings"),
		 "skin://icons/ic_videocam_48px.svg",
		 {
		 $clone.osdpage = 4;
		 focus("osd_settings_video");
		 });

	SIDEBAR_ACTION(_("Audio settings"),
		 "skin://icons/ic_speaker_48px.svg",
		 {
		 $clone.osdpage = 3;
		 focus("osd_settings_audio");
		 });

	SIDEBAR_ACTION(_("Subtitle settings"),
		 "skin://icons/ic_subtitles_48px.svg",
		 {
		 $clone.osdpage = 2;
		 focus("osd_settings_subs");
		 });

#import "skin://menu/sidebar_common.view"
	});
});
